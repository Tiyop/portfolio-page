---
const steps = [
  {
    n: "01",
    title: "Embed first",
    body: "Map the organisation before the data: incentives, constraints, and where past initiatives stalled. This happens in the field, alongside business experts.",
  },
  {
    n: "02",
    title: "Define good early",
    body: "The eval framework comes before the architecture. Agreeing what good means — rigorously enough to satisfy field teams and executives alike — is the foundation everything else is measured against.",
  },
  {
    n: "03",
    title: "Align everywhere",
    body: "C-suite, engineering and field staff each need their own reasons to say yes. Buy-in at one level never substitutes for another.",
  },
  {
    n: "04",
    title: "Pilot small, scale fast",
    body: "Start contained and let measured results do the convincing. A defensible improvement is what unlocks the next stage.",
  },
  {
    n: "05",
    title: "Hand off clean",
    body: "Mentor the team, write the documentation, set the MLOps standards. Success is a client team that no longer needs me.",
  },
];
---

<section class="methodology" id="methodology">
  <div class="container">

    <div class="methodology__header">
      <h2 class="label methodology__label">How I work</h2>
      <p class="methodology__subhead">
        The same playbook repeats across every engagement, whatever the sector or the stack.
      </p>
    </div>

    <ol class="steps" aria-label="Methodology steps">
      {steps.map((step, i) => (
        <li class="step">
          <div class="step__rule" aria-hidden="true"></div>
          <span class="step__number mono">{step.n}</span>
          <h3 class="step__title display">{step.title}</h3>
          <p class="step__body">{step.body}</p>
        </li>
      ))}
    </ol>

  </div>
</section>

<style>
  .methodology {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding-block: clamp(var(--space-12), 5vw, var(--space-16));
  }

  /* ─── Header ─────────────────────────────────────────────────────────────── */
  .methodology__header {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: var(--space-8) var(--space-16);
    margin-bottom: clamp(var(--space-8), 3vw, var(--space-12));
  }

  .methodology__label {
    white-space: nowrap;
  }

  .methodology__subhead {
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
    max-width: 680px;
  }

  /* ─── Steps grid ─────────────────────────────────────────────────────────── */
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-8);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .step__rule {
    height: 2px;
    background: var(--color-border-strong);
    margin-bottom: var(--space-2);
    position: relative;
  }

  .step__rule::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    height: 2px;
    width: 32px;
    background: var(--color-accent);
  }

  .step__number {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .step__title {
    font-size: var(--text-lg);
    font-weight: 650;
    line-height: var(--leading-snug);
    color: var(--color-text-primary);
  }

  .step__body {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
  }

  /* ─── Mobile ─────────────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8) var(--space-6);
    }
  }

  @media (max-width: 768px) {
    .methodology__header {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .steps {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
