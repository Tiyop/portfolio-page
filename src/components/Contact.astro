---
const email = 'ayoubsamaki@gmail.com';
const linkedin = 'https://www.linkedin.com/in/ayoub-samaki-0a158588/';
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="contact" id="contact">
  <div class="container">

    <div class="contact__layout">

      <div class="contact__portrait">
        <img src={`${base}/portrait.jpg`} alt="Portrait of Ayoub Samaki" width="540" height="600" loading="lazy" />
      </div>

      <div class="contact__content">
        <h2 class="contact__heading display">
          Let's talk.
        </h2>
        <p class="contact__subhead">
          Building or scaling a forward-deployed or applied AI team? I'd love to hear from you.
        </p>
        <div class="contact__actions">
          <a class="btn btn--solid" href={`mailto:${email}`}>Email me</a>
          <a class="btn btn--outline" href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        </div>
        <p class="contact__meta mono">
          Working in French, English, and Arabic.
        </p>
      </div>

    </div>

  </div>

  <footer class="footer">
    <div class="container footer__inner">
      <span class="footer__name mono">Ayoub Samaki</span>
      <span class="footer__meta">© {year} · Forward-Deployed AI Engineer &amp; Advisor</span>
    </div>
  </footer>
</section>

<style>
  .contact {
    background: var(--color-bg);
    padding-block: clamp(var(--space-12), 5vw, var(--space-16)) 0;
  }

  .contact__layout {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-12);
    align-items: center;
    padding-bottom: clamp(var(--space-12), 5vw, var(--space-16));
  }

  /* ─── Portrait ───────────────────────────────────────────────────────────── */
  .contact__portrait {
    width: 180px;
    height: 200px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px),
      var(--color-bg-secondary);
    background-size: 24px 24px, 24px 24px, auto;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .contact__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ─── Content ────────────────────────────────────────────────────────────── */

  .contact__heading {
    font-size: clamp(var(--text-3xl), 3.6vw, var(--text-5xl));
    line-height: var(--leading-tight);
    color: var(--color-text-primary);
    max-width: 720px;
    margin-bottom: var(--space-5);
  }

  .contact__subhead {
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
    max-width: 560px;
    margin-bottom: var(--space-8);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .contact__meta {
    margin-top: var(--space-6);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.06em;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-sm);
    transition: all var(--transition-base);
    cursor: pointer;
  }

  .btn--solid {
    background: var(--color-accent);
    color: #fff;
    border: 1px solid var(--color-accent);
  }

  .btn--solid:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    transform: translateY(-1px);
  }

  .btn--outline {
    background: transparent;
    color: var(--color-accent);
    border: 1px solid var(--color-accent-border-strong);
  }

  .btn--outline:hover {
    background: var(--color-accent-subtle);
    transform: translateY(-1px);
  }

  /* ─── Footer ─────────────────────────────────────────────────────────────── */
  .footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-6);
    background: var(--color-bg-secondary);
  }

  .footer__inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .footer__name {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .footer__meta {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* ─── Mobile ─────────────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .contact__layout {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .contact__portrait {
      width: 140px;
      height: 156px;
    }

    .footer__inner {
      flex-direction: column;
      gap: var(--space-1);
    }
  }
</style>
