---
import CaseStudyCard from './CaseStudyCard.astro';
import { caseStudies } from '../data/caseStudies';
---

<section class="case-studies" id="case-studies">
  <div class="container">

    <!-- Section header -->
    <div class="case-studies__header">
      <h2 class="case-studies__heading display">Selected engagements</h2>
      <p class="case-studies__subhead">
        Five deployments across luxury, retail and the public sector.
      </p>
    </div>

    <div class="case-studies__layout">

      <!-- Sticky index -->
      <nav class="index" aria-label="Case study index">
        <ol class="index__list">
          {caseStudies.map((study, i) => (
            <li>
              <a class={`index__link${i === 0 ? ' active' : ''}`} href={`#${study.id}`} data-target={study.id}>
                <span class="index__num mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="index__title">{study.shortTitle}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <!-- Stacked cards -->
      <div class="case-studies__stack">
        {caseStudies.map((study, i) => (
          <div class="case-studies__item">
            <CaseStudyCard study={study} index={i} />
          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<style>
  .case-studies {
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
    padding-block: clamp(var(--space-12), 5vw, var(--space-16));
  }

  /* ─── Header ─────────────────────────────────────────────────────────────── */
  .case-studies__header {
    margin-bottom: clamp(var(--space-6), 2.5vw, var(--space-10));
  }


  .case-studies__heading {
    margin-bottom: var(--space-3);
    font-size: clamp(var(--text-2xl), 3vw, var(--text-4xl));
    line-height: var(--leading-tight);
    color: var(--color-text-primary);
  }

  .case-studies__subhead {
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
    max-width: 640px;
  }

  /* ─── Layout ─────────────────────────────────────────────────────────────── */
  .case-studies__layout {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  /* ─── Index ──────────────────────────────────────────────────────────────── */
  .index {
    position: sticky;
    top: var(--space-10);
  }

  .index__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--color-border-strong);
  }

  .index__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-3) 0 var(--space-3) var(--space-4);
    margin-left: -1px;
    border-left: 2px solid transparent;
    transition: border-color var(--transition-base), color var(--transition-base);
  }

  .index__num {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-muted);
    transition: color var(--transition-base);
  }

  .index__title {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-snug);
    transition: color var(--transition-base);
  }

  .index__link:hover .index__title {
    color: var(--color-text-primary);
  }

  .index__link.active {
    border-left-color: var(--color-accent);
  }

  .index__link.active .index__num {
    color: var(--color-accent);
  }

  .index__link.active .index__title {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  /* ─── Stack ──────────────────────────────────────────────────────────────── */
  .case-studies__stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    min-width: 0;
  }

  /* ─── Mobile ─────────────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .case-studies__layout {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    /* The index becomes a sticky, swipeable chip bar */
    .index {
      top: 0;
      z-index: 5;
      margin-inline: calc(-1 * var(--space-6));
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .index::-webkit-scrollbar {
      display: none;
    }

    .index__list {
      flex-direction: row;
      gap: var(--space-2);
      border-left: none;
      padding: var(--space-3) var(--space-6);
      width: max-content;
    }

    .index__link {
      padding: var(--space-2) var(--space-3);
      margin-left: 0;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      white-space: nowrap;
      background: var(--color-surface);
    }

    .index__link.active {
      border-color: var(--color-accent-border);
      background: var(--color-accent-subtle);
    }

    /* Anchor jumps must clear the sticky bar */
    .case-studies__stack :global(.card) {
      scroll-margin-top: var(--space-20);
    }
  }
</style>

<script>
  // Highlight the index entry of the card currently in view.
  const links = document.querySelectorAll<HTMLAnchorElement>('.index__link');
  const cards = document.querySelectorAll<HTMLElement>('.case-studies__stack .card');

  if (links.length && cards.length) {
    const byId = new Map<string, HTMLAnchorElement>();
    links.forEach((link) => byId.set(link.dataset.target ?? '', link));

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            links.forEach((l) => l.classList.remove('active'));
            byId.get(entry.target.id)?.classList.add('active');
          }
        });
      },
      { rootMargin: '-30% 0px -60% 0px' }
    );

    cards.forEach((card) => observer.observe(card));
  }
</script>
