---
import type { CaseStudy } from '../data/caseStudies';
import CaseDiagram from './CaseDiagram.astro';

interface Props {
  study: CaseStudy;
  index: number;
}

const { study, index } = Astro.props;
---

<article class:list={["card", index % 2 === 1 && "card--flip"]} id={study.id} data-index={index}>

  <!-- Header: metric leads, tags trail -->
  <div class="card__header">
    <div class="card__topline">
      <div class="card__metric">
        <span class="card__metric-value mono">{study.metric.value}</span>
        <span class="card__metric-label">{study.metric.label}</span>
      </div>
      <p class="card__sector mono">{study.sector}</p>
    </div>
    <h3 class="card__title display">{study.title}</h3>
    <p class="card__context">{study.context}</p>
  </div>

  <!-- Body: build details + diagram -->
  <div class="card__body">
    <div class="card__col">
      <div class="card__block">
        <p class="card__block-label mono">My role</p>
        <p class="card__prose">{study.role}</p>
      </div>
      <div class="card__block">
        <p class="card__block-label mono">How it was built</p>
        <ul class="card__bullets">
          {study.approach.map(item => <li>{item}</li>)}
        </ul>
      </div>
    </div>
    <div class="card__col card__col--diagram">
      <CaseDiagram diagram={study.diagram} index={index} />
    </div>
  </div>

  <!-- Insight: full-width strip so columns stay balanced -->
  <div class="card__insight">
    <p class="card__block-label mono">What made it stick</p>
    <p class="card__prose">{study.insight}</p>
  </div>

  <!-- Results footer -->
  <footer class="card__footer">
    <p class="card__block-label card__footer-label mono">Results</p>
    <ul class="card__results">
      {study.results.map(item => <li>{item}</li>)}
    </ul>
  </footer>

</article>

<style>
  /* ─── Card ───────────────────────────────────────────────────────────────── */
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    overflow: hidden;
    scroll-margin-top: var(--space-8);
  }

  /* ─── Header ─────────────────────────────────────────────────────────────── */
  .card__header {
    padding: var(--space-6) var(--space-6) var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .card__topline {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .card__metric {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .card__metric-value {
    font-size: var(--text-3xl);
    font-weight: 600;
    line-height: 1;
    color: var(--color-accent);
    letter-spacing: -0.03em;
  }

  .card__metric-label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 26ch;
    line-height: var(--leading-snug);
  }

  .card__title {
    font-size: clamp(var(--text-xl), 2.2vw, var(--text-2xl));
    font-weight: 650;
    line-height: var(--leading-snug);
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .card__sector {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    padding-top: var(--space-2);
    white-space: nowrap;
  }

  .card__context {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
    max-width: 72ch;
  }

  /* ─── Body ───────────────────────────────────────────────────────────────── */
  .card__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--color-border);
  }

  .card__col {
    padding: var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .card__col:first-child {
    border-right: 1px solid var(--color-border);
  }

  .card__col--diagram {
    justify-content: center;
  }

  @media (min-width: 769px) {
    .card--flip .card__col--diagram {
      order: -1;
      border-right: 1px solid var(--color-border);
    }

    .card--flip .card__col:first-child {
      border-right: none;
    }
  }

  .card__insight {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-4) var(--space-6);
    align-items: baseline;
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  /* ─── Blocks ─────────────────────────────────────────────────────────────── */
  .card__block {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .card__block-label {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .card__bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .card__bullets li {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
    padding-left: var(--space-4);
    position: relative;
  }

  .card__bullets li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    top: 2px;
  }

  .card__prose {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
  }

  /* ─── Results footer ─────────────────────────────────────────────────────── */
  .card__footer {
    background: var(--color-bg-secondary);
    padding: var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .card__footer-label {
    color: var(--color-accent);
  }

  .card__results {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-8);
  }

  .card__results li {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-primary);
    padding-left: var(--space-4);
    position: relative;
  }

  .card__results li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-size: var(--text-xs);
    top: 3px;
  }

  /* ─── Mobile ─────────────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .card__header,
    .card__col,
    .card__insight,
    .card__footer {
      padding-inline: var(--space-4);
    }

    .card__insight {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .card__topline {
      flex-direction: column;
    }

    .card__sector {
      padding-top: 0;
    }

    .card__body {
      grid-template-columns: 1fr;
    }

    .card__col:first-child {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }

    .card__metric-value {
      font-size: var(--text-2xl);
      white-space: nowrap;
    }
  }
</style>
