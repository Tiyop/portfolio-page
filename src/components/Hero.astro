---
// Hero section — headline thesis left, measured-impact readout right
---

<section class="hero" id="hero">
  <div class="container hero__inner">

    <div class="hero__content">
      <!-- Eyebrow -->
      <div class="hero__eyebrow reveal">
        <p class="hero__name">Ayoub Samaki</p>
        <p class="hero__role label">Forward-Deployed AI Engineer &amp; Advisor</p>
      </div>

      <!-- Headline -->
      <h1 class="hero__headline display reveal reveal-delay-1">
        I turn AI pilots into systems people actually&nbsp;use.
      </h1>

      <!-- Subheadline -->
      <p class="hero__subhead reveal reveal-delay-2">
        Getting a pilot adopted is organisational work as much as engineering. I embed with client teams and own both, from first prototype to handover.
      </p>

      <!-- Industry tags -->
      <div class="hero__tags reveal reveal-delay-3" aria-label="Industry focus">
        <span class="tag tag--active">Luxury</span>
        <span class="tag tag--active">Retail</span>
        <span class="tag tag--active">Public sector</span>
        <span class="tag tag--active">Logistics</span>
        <span class="tag tag--active">Manufacturing</span>
      </div>

      <!-- CTA -->
      <div class="hero__cta reveal reveal-delay-4">
        <a href="#case-studies" class="btn btn--primary">See my work</a>
      </div>
    </div>

    <!-- Measured-impact readout -->
    <aside class="panel reveal reveal-delay-3" aria-label="Measured impact">
      <div class="panel__head">
        <span class="panel__label mono">Measured impact</span>
        <span class="panel__dot" aria-hidden="true"></span>
      </div>
      <dl class="panel__rows">
        <div class="panel__row">
          <dt class="panel__desc">Enterprise clients<br />across 5 industries</dt>
          <dd class="panel__value mono">20+</dd>
        </div>
        <div class="panel__row">
          <dt class="panel__desc">Incremental revenue<br />generated for clients</dt>
          <dd class="panel__value mono">€50M+</dd>
        </div>
        <div class="panel__row">
          <dt class="panel__desc">Years in AI<br />and data science</dt>
          <dd class="panel__value mono">10+</dd>
        </div>
      </dl>
      <p class="panel__foot mono">revenue counted against live client baselines</p>
    </aside>

  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding-block: clamp(var(--space-12), 9vh, var(--space-20));
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  /* Fine grid texture, top-right corner only */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 55% 55% at 100% 0%, black 0%, transparent 70%);
    opacity: 0.5;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 360px);
    gap: clamp(var(--space-10), 5vw, var(--space-20));
    align-items: center;
  }

  .hero__eyebrow {
    margin-bottom: var(--space-6);
  }

  .hero__name {
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-size: var(--text-xl);
    font-weight: 680;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-1);
  }

  .hero__role {
    color: var(--color-text-muted);
  }

  .hero__headline {
    font-size: clamp(var(--text-4xl), 4.6vw, 4.5rem);
    line-height: var(--leading-tight);
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
    max-width: 15ch;
  }


  .hero__subhead {
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: var(--leading-loose);
    color: var(--color-text-secondary);
    max-width: 560px;
    margin-bottom: var(--space-8);
  }

  /* ─── Tags ──────────────────────────────────────────────────────────────── */
  .hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px solid;
    transition: all var(--transition-fast);
  }

  .tag--active {
    color: var(--color-accent);
    border-color: var(--color-accent-border);
    background: var(--color-accent-subtle);
  }

  .tag--muted {
    color: var(--color-text-muted);
    border-color: var(--color-border);
    background: transparent;
  }

  /* ─── Readout panel ─────────────────────────────────────────────────────── */
  .panel {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    padding: var(--space-5) var(--space-6) var(--space-4);
  }

  /* Registration ticks, blueprint-style */
  .panel::before,
  .panel::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    pointer-events: none;
  }

  .panel::before {
    top: -7px;
    left: -7px;
    border-top: 1.5px solid var(--color-accent);
    border-left: 1.5px solid var(--color-accent);
  }

  .panel::after {
    bottom: -7px;
    right: -7px;
    border-bottom: 1.5px solid var(--color-accent);
    border-right: 1.5px solid var(--color-accent);
  }

  .panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border-strong);
  }

  .panel__label {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color-text-primary);
  }

  .panel__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
  }


  .panel__rows {
    display: flex;
    flex-direction: column;
  }

  .panel__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .panel__row + .panel__row {
    border-top: 1px solid var(--color-border);
  }

  .panel__value {
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: 1;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
  }

  .panel__desc {
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-text-secondary);
    letter-spacing: 0.03em;
  }

  .panel__foot {
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border-strong);
    padding-top: var(--space-3);
  }

  /* ─── CTA ────────────────────────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.06em;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-sm);
    transition: all var(--transition-base);
    cursor: pointer;
  }

  .btn--primary {
    background: transparent;
    color: var(--color-accent);
    border: 1px solid var(--color-accent-border-strong);
  }


  .btn--primary:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-btn-text-hover);
    transform: translateY(-1px);
  }



  /* ─── Mobile ─────────────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .hero {
      padding-block: var(--space-12);
    }

    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .hero__headline {
      font-size: clamp(var(--text-3xl), 8.5vw, var(--text-4xl));
      max-width: none;
    }

    .hero__subhead {
      font-size: var(--text-base);
    }

    .panel {
      max-width: 420px;
    }

    .panel__value {
      font-size: var(--text-2xl);
    }
  }
</style>
